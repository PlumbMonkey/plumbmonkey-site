{
  "name": "plumbmonkey-api",
  "private": true,
  "description": "Global arcade high scores + private visit counts for plumbmonkey.online (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 execute plumbmonkey --local --file schema.sql",
    "db:remote": "wrangler d1 execute plumbmonkey --remote --file schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.131.1"
  }
}
